#!/usr/bin/env python3
"""Executable launcher for Google Flow Account Manager CLI."""

import sys
from pathlib import Path

# Add project root directory to sys.path so it works out of the box
project_root = Path(__file__).resolve().parent.parent
if str(project_root) not in sys.path:
    sys.path.insert(0, str(project_root))

from flow_account.cli import main

if __name__ == "__main__":
    sys.exit(main())
