# Flow Credit Rotator Configuration
# Copy this file to .env or export variables in your environment.

# Database file location (SQLite)
# Default: ~/.flow-accounts/flow_accounts.db
FLOW_ACCOUNT_DB_PATH=~/.flow-accounts/flow_accounts.db

# Default daily credit limit applied to new accounts (Configurable, never hardcoded)
FLOW_ACCOUNT_DEFAULT_DAILY_LIMIT=85

# Timezone used for daily and monthly credit rollover calculations
# Default: America/Bahia
FLOW_ACCOUNT_TIMEZONE=America/Bahia

# Default rotation strategy (sequential | random | round-robin | lowest-usage | priority)
# Default: sequential
FLOW_ACCOUNT_STRATEGY=sequential

# ------------------------------------------------------------------------------
# CREDENTIAL ISOLATION & SECURITY GUIDELINES
# ------------------------------------------------------------------------------
# NEVER store raw passwords, plaintext tokens, or API secrets in this file,
# in CSV spreadsheets, or in the SQLite database.
#
# Use credential references ('credential_ref') pointing to external secret stores:
# Examples:
#   ENV:FLOW_ACCOUNT_01_PASS      (Loaded by automation runtime from dedicated env)
#   OP:vault/flow-account-01/pass (1Password reference)
#   BWS:secret-uuid               (Bitwarden Secrets Manager)
#   KEYRING:flow-account-01       (OS Keyring)
